# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Microsoft 365 SMTP OAuth2 (client credentials; requires Exchange SMTP.SendAsApp setup).
MAIL_HOST="smtp.office365.com"
MAIL_PORT="587"
MAIL_USER="notifications@example.com"
MAIL_FROM="notifications@example.com"
MAIL_TENANT_ID="your-tenant-id"
MAIL_CLIENT_ID="your-application-client-id"
MAIL_CLIENT_SECRET="replace-with-secret"
