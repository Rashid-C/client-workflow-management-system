  {
    "id": "trigger.AuditLog.appendOnly",
    "label": "Make \"AuditLog\" append-only",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "AuditLog"
      }
    },
    "precheck": [
      {
        "description": "ensure the append-only function does not exist yet",
        "sql": "SELECT to_regprocedure('public.\"AuditLog_reject_change\"()') IS NULL AS \"result\""
      }
    ],
    "execute": [
      {
        "description": "create the function that rejects changes",
        "sql": "CREATE FUNCTION \"public\".\"AuditLog_reject_change\"() RETURNS trigger\nLANGUAGE plpgsql AS $body$\nBEGIN\n  RAISE EXCEPTION 'AuditLog is append-only: % is not allowed', TG_OP\n    USING ERRCODE = 'insufficient_privilege';\nEND;\n$body$"
      },
      {
        "description": "reject UPDATE and DELETE on every row",
        "sql": "CREATE TRIGGER \"AuditLog_append_only\"\nBEFORE UPDATE OR DELETE ON \"public\".\"AuditLog\"\nFOR EACH ROW EXECUTE FUNCTION \"public\".\"AuditLog_reject_change\"()"
      },
      {
        "description": "reject TRUNCATE of the whole table",
        "sql": "CREATE TRIGGER \"AuditLog_no_truncate\"\nBEFORE TRUNCATE ON \"public\".\"AuditLog\"\nFOR EACH STATEMENT EXECUTE FUNCTION \"public\".\"AuditLog_reject_change\"()"
      }
    ],
    "postcheck": [
      {
        "description": "verify both append-only triggers exist",
        "sql": "SELECT count(*) = 2 AS \"result\" FROM pg_trigger\nWHERE tgrelid = '\"public\".\"AuditLog\"'::regclass\n  AND tgname IN ('AuditLog_append_only', 'AuditLog_no_truncate')"
      }
    ]
  }
