      {
        "description": "continue after any CL-n code that already exists",
        "sql": "SELECT setval('\"public\".\"Client_code_seq\"',\n  COALESCE((SELECT max(substring(\"clientCode\" from 4)::int) FROM \"public\".\"Client\"\n            WHERE \"clientCode\" ~ '^CL-[0-9]{1,9}$'), 0) + 1, false)"
      }
