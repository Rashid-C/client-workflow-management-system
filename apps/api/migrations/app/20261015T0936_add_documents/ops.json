    "execute": [
      {
        "description": "create table \"Document\"",
        "sql": "CREATE TABLE \"public\".\"Document\" (\n  \"archivedAt\" timestamptz,\n  \"clientId\" int4 NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdById\" int4 NOT NULL,\n  \"documentNumber\" text,\n  \"expiryDate\" date,\n  \"id\" SERIAL NOT NULL,\n  \"issueDate\" date,\n  \"notes\" text,\n  \"reminderDays\" int4 DEFAULT 30 NOT NULL,\n  \"title\" text,\n  \"type\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"version\" int4 DEFAULT 1 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Document_dates_order_0740a985\" CHECK (\"issueDate\" IS NULL OR \"expiryDate\" IS NULL OR \"expiryDate\" >= \"issueDate\"),\n  CONSTRAINT \"Document_reminderDays_range_92ab7f9b\" CHECK (\"reminderDays\" BETWEEN 0 AND 365),\n  CONSTRAINT \"Document_type_check_efff8b40\" CHECK (\"type\" IN ('Trade licence', 'VAT certificate', 'Corporate tax certificate', 'ICV certificate', 'ADNOC vendor registration', 'Emirates ID', 'Passport', 'Residence visa', 'Tenancy contract (Ejari)', 'Memorandum of association', 'Power of attorney', 'Other'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Document\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"Document\""
        ]
      }
    ]
