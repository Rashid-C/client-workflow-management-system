// use prisma-8
model Client {
  id          Int                        @id @default(autoincrement())
  clientCode  String                     @unique
  name        String
  email       String?
  phone       String?
  companyName String?
  address     String?
  notes       String?
  isActive    Boolean                    @default(true)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

enum EmployeeStatus {
  @@type("pg/text@1")
  Active   = "Active"
  Inactive = "Inactive"
}

model Employee {
  id           Int                        @id @default(autoincrement())
  employeeCode String                     @unique
  name         String
  email        String                     @unique
  phone        String?
  designation  String
  status       EmployeeStatus             @default(Active)
  joinedDate   DateString
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

// Permissions themselves are a fixed catalogue in API code; the database
// stores which role holds which permission key, and at what scope.
enum PermissionScope {
  @@type("pg/text@1")
  Own = "own"
  All = "all"
}

model Role {
  id          Int                        @id @default(autoincrement())
  name        String
  description String?
  // System roles (Super Admin) cannot be edited or deleted.
  isSystem    Boolean                    @default(false)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  // "Manager" and "manager" must not both exist.
  @@index(expression: "lower(name)", unique: true, name: "Role_name_lower_key")
}

model RolePermission {
  id            Int               @id @default(autoincrement())
  roleId        Int
  role          Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  scope         PermissionScope   @default(All)
  createdAt     TimestamptzString @default(now())

  @@unique([roleId, permissionKey])
}

model EmployeeRole {
  id         Int               @id @default(autoincrement())
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleId     Int
  // A role still held by someone cannot be deleted.
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt  TimestamptzString @default(now())

  @@unique([employeeId, roleId])
  @@index([roleId])
}

// Kept apart from Employee so no employee query can return a password hash.
model EmployeeCredential {
  id                 Int                        @id @default(autoincrement())
  employeeId         Int                        @unique
  employee           Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // argon2id, encoded as $argon2id$v=19$m=...,t=...,p=...$salt$hash
  passwordHash       String
  // Set when an admin issues a temporary password.
  mustChangePassword Boolean                    @default(true)
  failedAttempts     Int                        @default(0)
  lockedUntil        TimestamptzString?
  passwordChangedAt  TimestamptzString          @default(now())
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()
}

model Session {
  id         Int               @id @default(autoincrement())
  // SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String            @unique
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  TimestamptzString @default(now())
  lastSeenAt TimestamptzString @default(now())
  expiresAt  TimestamptzString
  ipAddress  String?
  userAgent  String?

  @@index([employeeId])
}

// Who did what, when and why. Append-only: a database trigger rejects
// UPDATE and DELETE, and entries are written in the same transaction as the
// change they describe.
model AuditLog {
  id              Int               @id @default(autoincrement())
  occurredAt      TimestamptzString @default(now())
  // Null only for actions with no signed-in person (e.g. a failed sign-in).
  actorEmployeeId Int?
  // Employees are deactivated, never deleted, so history keeps its actor.
  actor           Employee?         @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  // The actor's name at the time, as later renames must not rewrite history.
  actorName       String?
  action          String
  entityType      String
  entityId        String
  summary         String
  // { field: { from, to } } for updates; the new values for creations.
  changes         Jsonb?
  reason          String?
  ipAddress       String?
  userAgent       String?

  @@index([entityType, entityId, id])
  @@index([actorEmployeeId, id])
  @@index([occurredAt])
}

// A kind of engagement (Audit, ICV...) and the stages it runs through.
// Tasks copy the stages when they are created, so editing a type only
// affects new tasks.
model TaskType {
  id          Int                        @id @default(autoincrement())
  name        String
  description String?
  // A type already used by tasks is deactivated instead of deleted.
  isActive    Boolean                    @default(true)
  // Bumped on every save; a save based on an older version is refused,
  // so two admins editing at once cannot overwrite each other unseen.
  version     Int                        @default(1)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@index(expression: "lower(name)", unique: true, name: "TaskType_name_lower_key")
}

model TaskTypeStage {
  id         Int               @id @default(autoincrement())
  taskTypeId Int
  taskType   TaskType          @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  // 1-based order in which the stages are worked.
  position   Int
  name       String
  createdAt  TimestamptzString @default(now())

  @@unique([taskTypeId, position])
  @@check(expression: "\"position\" >= 1", name: "TaskTypeStage_position_positive")
}
