// use prisma-8
model Client {
  id          Int                        @id @default(autoincrement())
  clientCode  String                     @unique
  name        String
  email       String?
  phone       String?
  companyName String?
  address     String?
  notes       String?
  isActive    Boolean                    @default(true)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

enum EmployeeStatus {
  @@type("pg/text@1")
  Active   = "Active"
  Inactive = "Inactive"
}

model Employee {
  id           Int                        @id @default(autoincrement())
  employeeCode String                     @unique
  name         String
  email        String                     @unique
  phone        String?
  designation  String
  status       EmployeeStatus             @default(Active)
  joinedDate   DateString
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

// Permissions themselves are a fixed catalogue in API code; the database
// stores which role holds which permission key, and at what scope.
enum PermissionScope {
  @@type("pg/text@1")
  Own = "own"
  All = "all"
}

model Role {
  id          Int                        @id @default(autoincrement())
  name        String
  description String?
  // System roles (Super Admin) cannot be edited or deleted.
  isSystem    Boolean                    @default(false)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  // "Manager" and "manager" must not both exist.
  @@index(expression: "lower(name)", unique: true, name: "Role_name_lower_key")
}

model RolePermission {
  id            Int               @id @default(autoincrement())
  roleId        Int
  role          Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  scope         PermissionScope   @default(All)
  createdAt     TimestamptzString @default(now())

  @@unique([roleId, permissionKey])
}

model EmployeeRole {
  id         Int               @id @default(autoincrement())
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleId     Int
  // A role still held by someone cannot be deleted.
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt  TimestamptzString @default(now())

  @@unique([employeeId, roleId])
  @@index([roleId])
}

// Kept apart from Employee so no employee query can return a password hash.
model EmployeeCredential {
  id                 Int                        @id @default(autoincrement())
  employeeId         Int                        @unique
  employee           Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // argon2id, encoded as $argon2id$v=19$m=...,t=...,p=...$salt$hash
  passwordHash       String
  // Set when an admin issues a temporary password.
  mustChangePassword Boolean                    @default(true)
  failedAttempts     Int                        @default(0)
  lockedUntil        TimestamptzString?
  passwordChangedAt  TimestamptzString          @default(now())
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()
}

model Session {
  id         Int               @id @default(autoincrement())
  // SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String            @unique
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  TimestamptzString @default(now())
  lastSeenAt TimestamptzString @default(now())
  expiresAt  TimestamptzString
  ipAddress  String?
  userAgent  String?

  @@index([employeeId])
}
