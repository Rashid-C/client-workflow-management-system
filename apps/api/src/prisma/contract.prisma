// use prisma-8
// The firm's clients. Values of these enums are stored as shown and
// translated by the web app.
enum ClientEntityType {
  @@type("pg/text@1")
  Llc               = "LLC"
  SoleEstablishment = "Sole establishment"
  CivilCompany      = "Civil company"
  Branch            = "Branch"
  JointStock        = "Joint stock company"
  Partnership       = "Partnership"
  Individual        = "Individual"
  Other             = "Other"
}

// Mainland or free zone decides corporate tax treatment (qualifying free
// zone persons) and which authority issues the licence.
enum Jurisdiction {
  @@type("pg/text@1")
  Mainland = "Mainland"
  FreeZone = "Free zone"
  Offshore = "Offshore"
}

enum Emirate {
  @@type("pg/text@1")
  AbuDhabi     = "Abu Dhabi"
  Dubai        = "Dubai"
  Sharjah      = "Sharjah"
  Ajman        = "Ajman"
  UmmAlQuwain  = "Umm Al Quwain"
  RasAlKhaimah = "Ras Al Khaimah"
  Fujairah     = "Fujairah"
}

model Client {
  id          Int                        @id @default(autoincrement())
  // CL-0001…, issued by the API from Client_code_seq.
  clientCode  String                     @unique
  name        String
  // Legal name as on the trade licence, in English and Arabic.
  companyName String?
  legalNameAr String?
  email       String?
  phone       String?
  address     String?
  notes       String?

  entityType         ClientEntityType?
  jurisdiction       Jurisdiction?
  freeZone           String?
  emirate            Emirate?
  tradeLicenseNumber String?
  licenseAuthority   String?
  businessActivity   String?

  // Federal Tax Authority registration numbers (15 digits each).
  vatTrn          String?                @unique
  corporateTaxTrn String?                @unique
  // Month the financial year ends (12 = December); drives audit and
  // corporate tax return dates.
  financialYearEndMonth Int?

  contactName        String?
  contactDesignation String?
  contactEmail       String?
  contactPhone       String?

  // The staff member responsible for the client.
  accountManagerId Int?
  accountManager   Employee?             @relation(fields: [accountManagerId], references: [id], onDelete: Restrict)

  isActive    Boolean                    @default(true)
  // Guards edits against lost updates.
  version     Int                        @default(1)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([accountManagerId])
  @@check(expression: "\"vatTrn\" ~ '^[0-9]{15}$'", name: "Client_vatTrn_format")
  @@check(expression: "\"corporateTaxTrn\" ~ '^[0-9]{15}$'", name: "Client_corporateTaxTrn_format")
  @@check(expression: "\"financialYearEndMonth\" BETWEEN 1 AND 12", name: "Client_financialYearEndMonth_range")
}

enum EmployeeStatus {
  @@type("pg/text@1")
  Active   = "Active"
  Inactive = "Inactive"
}

model Employee {
  id           Int                        @id @default(autoincrement())
  employeeCode String                     @unique
  name         String
  email        String                     @unique
  phone        String?
  designation  String
  status       EmployeeStatus             @default(Active)
  joinedDate   DateString
  // UI language; follows the person to any computer they sign in on.
  preferredLanguage Language              @default(En)
  // Guards edits against lost updates.
  version      Int                        @default(1)
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

enum Language {
  @@type("pg/text@1")
  En = "en"
  Ar = "ar"
}

// Permissions themselves are a fixed catalogue in API code; the database
// stores which role holds which permission key, and at what scope.
enum PermissionScope {
  @@type("pg/text@1")
  Own = "own"
  All = "all"
}

model Role {
  id          Int                        @id @default(autoincrement())
  name        String
  description String?
  // System roles (Super Admin) cannot be edited or deleted.
  isSystem    Boolean                    @default(false)
  // Guards edits against lost updates.
  version     Int                        @default(1)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  // "Manager" and "manager" must not both exist.
  @@index(expression: "lower(name)", unique: true, name: "Role_name_lower_key")
}

model RolePermission {
  id            Int               @id @default(autoincrement())
  roleId        Int
  role          Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  scope         PermissionScope   @default(All)
  createdAt     TimestamptzString @default(now())

  @@unique([roleId, permissionKey])
}

model EmployeeRole {
  id         Int               @id @default(autoincrement())
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleId     Int
  // A role still held by someone cannot be deleted.
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt  TimestamptzString @default(now())

  @@unique([employeeId, roleId])
  @@index([roleId])
}

// Kept apart from Employee so no employee query can return a password hash.
model EmployeeCredential {
  id                 Int                        @id @default(autoincrement())
  employeeId         Int                        @unique
  employee           Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // argon2id, encoded as $argon2id$v=19$m=...,t=...,p=...$salt$hash
  passwordHash       String
  // Set when an admin issues a temporary password.
  mustChangePassword Boolean                    @default(true)
  failedAttempts     Int                        @default(0)
  lockedUntil        TimestamptzString?
  passwordChangedAt  TimestamptzString          @default(now())
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()
}

model Session {
  id         Int               @id @default(autoincrement())
  // SHA-256 of the cookie token; the token itself is never stored.
  tokenHash  String            @unique
  employeeId Int
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  TimestamptzString @default(now())
  lastSeenAt TimestamptzString @default(now())
  expiresAt  TimestamptzString
  ipAddress  String?
  userAgent  String?

  @@index([employeeId])
}

// Who did what, when and why. Append-only: a database trigger rejects
// UPDATE and DELETE, and entries are written in the same transaction as the
// change they describe.
model AuditLog {
  id              Int               @id @default(autoincrement())
  occurredAt      TimestamptzString @default(now())
  // Null only for actions with no signed-in person (e.g. a failed sign-in).
  actorEmployeeId Int?
  // Employees are deactivated, never deleted, so history keeps its actor.
  actor           Employee?         @relation(fields: [actorEmployeeId], references: [id], onDelete: Restrict)
  // The actor's name at the time, as later renames must not rewrite history.
  actorName       String?
  action          String
  entityType      String
  entityId        String
  summary         String
  // { field: { from, to } } for updates; the new values for creations.
  changes         Jsonb?
  reason          String?
  ipAddress       String?
  userAgent       String?

  @@index([entityType, entityId, id])
  @@index([actorEmployeeId, id])
  @@index([occurredAt])
}

// A kind of engagement (Audit, ICV...) and the stages it runs through.
// Tasks copy the stages when they are created, so editing a type only
// affects new tasks.
model TaskType {
  id          Int                        @id @default(autoincrement())
  name        String
  description String?
  // A type already used by tasks is deactivated instead of deleted.
  isActive    Boolean                    @default(true)
  // Bumped on every save; a save based on an older version is refused,
  // so two admins editing at once cannot overwrite each other unseen.
  version     Int                        @default(1)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@index(expression: "lower(name)", unique: true, name: "TaskType_name_lower_key")
}

model TaskTypeStage {
  id         Int               @id @default(autoincrement())
  taskTypeId Int
  taskType   TaskType          @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  // 1-based order in which the stages are worked.
  position   Int
  name       String
  createdAt  TimestamptzString @default(now())

  @@unique([taskTypeId, position])
  @@check(expression: "\"position\" >= 1", name: "TaskTypeStage_position_positive")
}

// Shared by stages and tasks. A task's status is derived from its stages
// and stored alongside them in the same transaction, so lists and
// dashboards never have to recompute it.
enum WorkStatus {
  @@type("pg/text@1")
  Pending    = "Pending"
  InProgress = "In progress"
  Completed  = "Completed"
  Blocked    = "Blocked"
}

// One engagement for one client, of one task type. Archived, never deleted.
model Task {
  id          Int                        @id @default(autoincrement())
  title       String
  description String?
  clientId    Int
  client      Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  taskTypeId  Int
  taskType    TaskType                   @relation(fields: [taskTypeId], references: [id], onDelete: Restrict)
  dueDate     DateString?
  status      WorkStatus                 @default(Pending)
  createdById Int
  createdBy   Employee                   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt  TimestamptzString?
  // Guards edits of title, description and due date against lost updates.
  version     Int                        @default(1)
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([status, dueDate])
  @@index([createdById])
}

// A task's own copy of its type's stages, worked strictly in order.
model TaskStage {
  id            Int                        @id @default(autoincrement())
  taskId        Int
  task          Task                       @relation(fields: [taskId], references: [id], onDelete: Restrict)
  position      Int
  name          String
  status        WorkStatus                 @default(Pending)
  assigneeId    Int?
  assignee      Employee?                  @relation("TaskStageAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  startedAt     TimestamptzString?
  completedAt   TimestamptzString?
  // Kept on the stage so the "Blocked, with reasons" list needs no join
  // into the audit log; the full history is in AuditLog.
  blockedReason String?
  blockedAt     TimestamptzString?
  blockedById   Int?
  blockedBy     Employee?                  @relation("TaskStageBlockedBy", fields: [blockedById], references: [id], onDelete: Restrict)
  updatedAt     temporal.updatedAtString()

  @@unique([taskId, position])
  @@index([assigneeId, status])
  @@check(expression: "\"position\" >= 1", name: "TaskStage_position_positive")
}

// Time spent on a stage, recorded when completing or blocking it.
model TimeEntry {
  id          Int               @id @default(autoincrement())
  taskStageId Int
  taskStage   TaskStage         @relation(fields: [taskStageId], references: [id], onDelete: Restrict)
  // Copied from the stage so time-log reports filter tasks without a join.
  taskId      Int
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  employeeId  Int
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // The office day the work was done.
  workDate    DateString
  minutes     Int
  note        String?
  createdAt   TimestamptzString @default(now())

  @@index([employeeId, workDate])
  @@index([workDate])
  @@check(expression: "\"minutes\" BETWEEN 1 AND 720", name: "TimeEntry_minutes_range")
}

// Client documents whose expiry the office tracks (licences, certificates,
// IDs). Files are not stored yet — only the record and its dates.
enum DocumentType {
  @@type("pg/text@1")
  TradeLicence        = "Trade licence"
  VatCertificate      = "VAT certificate"
  CorporateTaxCert    = "Corporate tax certificate"
  IcvCertificate      = "ICV certificate"
  AdnocRegistration   = "ADNOC vendor registration"
  EmiratesId          = "Emirates ID"
  Passport            = "Passport"
  ResidenceVisa       = "Residence visa"
  TenancyContract     = "Tenancy contract (Ejari)"
  Memorandum          = "Memorandum of association"
  PowerOfAttorney     = "Power of attorney"
  Other               = "Other"
}

model Document {
  id             Int                        @id @default(autoincrement())
  clientId       Int
  client         Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  type           DocumentType
  // e.g. "Owner — Ahmed Ali" for an Emirates ID.
  title          String?
  documentNumber String?
  issueDate      DateString?
  // Null for documents that never expire (e.g. an MOA).
  expiryDate     DateString?
  // How many days before expiry it counts as "expiring soon".
  reminderDays   Int                        @default(30)
  notes          String?
  createdById    Int
  createdBy      Employee                   @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  // Deleting archives the record, so its history stays readable.
  archivedAt     TimestamptzString?
  version        Int                        @default(1)
  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([clientId])
  @@index([expiryDate])
  @@check(expression: "\"reminderDays\" BETWEEN 0 AND 365", name: "Document_reminderDays_range")
  @@check(expression: "\"issueDate\" IS NULL OR \"expiryDate\" IS NULL OR \"expiryDate\" >= \"issueDate\"", name: "Document_dates_order")
}

// Prospective clients and the follow-ups that move them along.
enum LeadStatus {
  @@type("pg/text@1")
  New          = "New"
  Contacted    = "Contacted"
  ProposalSent = "Proposal sent"
  Won          = "Won"
  Lost         = "Lost"
}

enum LeadSource {
  @@type("pg/text@1")
  Referral    = "Referral"
  Website     = "Website"
  WalkIn      = "Walk-in"
  Phone       = "Phone"
  SocialMedia = "Social media"
  Other       = "Other"
}

enum FollowUpKind {
  @@type("pg/text@1")
  Call     = "Call"
  Meeting  = "Meeting"
  Email    = "Email"
  WhatsApp = "WhatsApp"
  Other    = "Other"
}

model Lead {
  id               Int                        @id @default(autoincrement())
  // The prospect: usually a company, sometimes a person.
  name             String
  contactName      String?
  email            String?
  phone            String?
  source           LeadSource?
  // Service keys the prospect is interested in, e.g. ["vat", "audit"].
  services         Jsonb?
  // Whole dirhams.
  estimatedValue   Int?
  status           LeadStatus                 @default(New)
  ownerId          Int?
  owner            Employee?                  @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  nextFollowUpDate DateString?
  lostReason       String?
  notes            String?
  // Set when the lead is converted into a client.
  clientId         Int?                       @unique
  client           Client?                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdById      Int
  createdBy        Employee                   @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  archivedAt       TimestamptzString?
  version          Int                        @default(1)
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([status])
  @@index([ownerId])
  @@index([nextFollowUpDate])
  @@check(expression: "\"estimatedValue\" IS NULL OR \"estimatedValue\" >= 0", name: "Lead_estimatedValue_positive")
}

// Each contact with a lead; append-only, like the audit log.
model LeadFollowUp {
  id          Int                        @id @default(autoincrement())
  leadId      Int
  lead        Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind        FollowUpKind
  note        String
  // The day it happened (office time).
  happenedOn  DateString
  createdById Int
  createdBy   Employee                   @relation("LeadFollowUpBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   TimestamptzString          @default(now())

  @@index([leadId, happenedOn])
}

// Each person's end-of-day note: one per office day, editable only that day.
model DailyUpdate {
  id         Int                        @id @default(autoincrement())
  employeeId Int
  employee   Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // The office day it covers (Asia/Dubai).
  day        DateString
  done       String
  plan       String?
  blockers   String?
  version    Int                        @default(1)
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([employeeId, day])
  @@index([day])
}

// Firm-wide settings: exactly one row (id 1), created by the migration.
model Setting {
  id                   Int                        @id
  companyName          String
  companyNameAr        String?
  // The firm's own FTA registration number.
  companyTrn           String?
  email                String?
  phone                String?
  address              String?
  // ISO weekdays (1 = Monday … 7 = Sunday) the office works.
  workingDays          Jsonb
  // "08:30" style, office time.
  workdayStart         String
  workdayEnd           String
  // Default "warn this many days before expiry" for new documents.
  documentReminderDays Int                        @default(30)
  version              Int                        @default(1)
  updatedAt            temporal.updatedAtString()

  @@check(expression: "\"id\" = 1", name: "Setting_single_row")
  @@check(expression: "\"documentReminderDays\" BETWEEN 0 AND 365", name: "Setting_documentReminderDays_range")
  @@check(expression: "\"workdayStart\" ~ '^[0-2][0-9]:[0-5][0-9]$' AND \"workdayEnd\" ~ '^[0-2][0-9]:[0-5][0-9]$'", name: "Setting_workday_format")
}
