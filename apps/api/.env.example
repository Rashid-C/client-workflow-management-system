# Copy to .env on the office API machine. Keep .env out of source control.
# Use the non-DDL runtime role. PostgreSQL is local to the office machine.
DATABASE_URL="postgresql://tickwise_app:replace-me@127.0.0.1:5432/tickwise_prod"
PORT=3001
APP_TIME_ZONE=Asia/Dubai
WEB_ORIGINS=https://app.example.com
# cloudflared runs on this same Windows machine and is the only trusted proxy.
TRUST_PROXY=loopback

# Optional Microsoft 365 OAuth mail. Fill these only after the OAuth app is ready.
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USER=notifications@example.com
# MAIL_FROM=notifications@example.com
# MAIL_TENANT_ID=replace-with-tenant-id
# MAIL_CLIENT_ID=replace-with-client-id
# MAIL_CLIENT_SECRET=replace-with-client-secret
